# PostgreSQL connection string. For a 5-minute free instance: https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth — also used as the app's canonical base URL for building the
# download link that gets emailed to buyers.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Cloudinary (free tier: https://cloudinary.com) — image storage, watermarking, signed URLs
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe TEST MODE keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Secret used to sign short-lived download tokens
DOWNLOAD_TOKEN_SECRET="generate-with: openssl rand -base64 32"

# Resend (free tier: https://resend.com) — sends the download link by email
# from inside the webhook. If unset, email sending is skipped (logged, not fatal)
# and the success page remains the fallback.
RESEND_API_KEY=""
EMAIL_FROM="orders@yourdomain.com"

# Text baked into the bottom-right corner of every public preview image.
# Optional — defaults to "PORTFOLIO" if unset.
WATERMARK_TEXT="PORTFOLIO"

# Where contact-page form submissions get forwarded. If unset, submissions
# are validated but not delivered (visitor sees an honest error, logged server-side).
CONTACT_RECIPIENT_EMAIL="you@yourdomain.com"

# Upstash Redis (free tier, REST-based — no persistent connection needed,
# works from serverless functions: https://upstash.com). If unset, rate
# limiting is skipped (logged, fails open) rather than blocking requests.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Used only by `npm run seed` to create the first admin account — not read at runtime
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
